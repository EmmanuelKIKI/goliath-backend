# Je copie ce fichier en ".env" pour tourner en local, et je reporte
# les mêmes variables dans le tableau "Environment" de Render pour
# la production. Je ne mets JAMAIS mon vrai .env dans Git.

# --- Base de données (Supabase) ---
# Dans mon projet Supabase : Project Settings > Database > Connection string.
#
# DATABASE_URL = connexion "Transaction pooler" (port 6543, pgbouncer=true).
# C'est celle que mon serveur utilise pour toutes ses requêtes courantes.
DATABASE_URL="postgresql://postgres.MON_ID_PROJET:MON_MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL = connexion directe (port 5432, sans pooler).
# Utilisée uniquement par Prisma pour synchroniser mon schéma
# ("npm run prisma:deploy"), le pooler ne le supporte pas.
DIRECT_URL="postgresql://postgres.MON_ID_PROJET:MON_MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Serveur ---
# En local je choisis mon port. Sur Render, la plateforme injecte sa
# propre variable PORT automatiquement : je n'ai rien à faire, mon
# code lit déjà process.env.PORT en priorité.
PORT=4000

# --- Authentification ---
JWT_SECRET="je-remplace-cette-valeur-par-une-longue-chaine-secrete-et-aleatoire"
JWT_EXPIRES_IN="30d"

# Le nom que je dois taper pour entrer dans mon application. Je suis
# seul à avoir le lien de mon app, donc pas besoin d'email ni de mot
# de passe : juste ce nom, comparé sans tenir compte des majuscules.
ACCES_NOM="kiki"

# --- CORS ---
# L'adresse de mon frontend autorisée à appeler mon API.
# En local : http://localhost:5173
# En production : l'URL réelle de ma PWA une fois déployée.
FRONTEND_URL="http://localhost:5173"

# --- Environnement ---
# "development" en local, "production" sur Render.
NODE_ENV=development
