{
  "name": "goliath-backend",
  "version": "1.0.0",
  "description": "API de ma plateforme de gestion d'élevage de poulets Goliath - je gère mes bandes, ma santé animale, mes stocks, mes finances et mes tâches depuis une seule application.",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma db push --accept-data-loss",
    "prisma:studio": "prisma studio"
  },
  "author": "Jean Kiki",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.19.1"
  }
}
